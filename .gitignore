__pycache__/
*.py[cod]
.venv/
node_modules/
.DS_Store
Thumbs.db
*.log
.env
.env.*
!.env.example

# Large downloaded data stays local; retain cache documentation.
raw/*
!raw/README.md
!raw/archive/
raw/archive/*
!raw/archive/README.md

# Repository metadata fallback for environments with a read-only .git mount.
.git-local/

# Sites maintains its own repository metadata; project source is tracked here.
website/.git/

# Local SQLite files. Saved backtests, the queue and variable library are durable.
# Keep these user records when rebuilding research or schedule caches.
data/*.sqlite
data/*.sqlite-*
data/*.building*
data/numerical/
data/numerical-native/
data/numerical-preparation.json
data/numerical-preparation.json.download
data/numerical-preparation.lock
data/numerical-preparation.lock.live/
data/numerical-preparation-*.json
data/numerical-preparation-*.json.download
data/numerical-preparation-*.lock
data/numerical-preparation-*.lock.live/

# Rebuildable website output. `website/build.py --snapshot` writes the portable
# export to website/dist/; neither folder is tracked.
website/local/
website/dist/

# Local background website identity and startup lock.
data/website-server-*.json
data/website-launch-*.lock
data/website-owner-*.lock
data/website-update-stop-*

# Browser verification snapshots and screenshots.
.playwright-mcp/

# Serialize data management and startup across local servers.
data/website-data-*.lock
data/website-data-*.lock.live/
data/backtest-queue.lock
data/backtest-queue.lock.live/

# Per-process development logs and their rotated backups.
data/logs/

# Disposable API experiments, response memoization and benchmark caches.
tmp/

# Local baseline revision evidence and interrupted publication receipts.
results/baseline-history/
data/*.publication.json
data/*.publication.json.download

# Local WSL/native-Windows workspace registration and publication receipts.
data/workspace.json
data/workspace-*.json
data/deployment*.json
data/website-source.lock
.deployment/
