__pycache__/
*.py[cod]
.venv/
node_modules/
.DS_Store
Thumbs.db
*.log
.env
.env.*
!.env.example

# Large downloaded data stays local; retain cache documentation.
raw/*
!raw/README.md
!raw/archive/
raw/archive/*
!raw/archive/README.md

# Repository metadata fallback for environments with a read-only .git mount.
.git-local/

# Sites maintains its own repository metadata; project source is tracked here.
website/.git/

# Rebuildable prepared research database.
data/*.sqlite
data/*.sqlite-*
data/*.building*

# Local website build freshness stamp.
website/dist/.build-state.json
website/dist/.build-state.tmp

# Local background website identity and startup lock.
data/website-server-*.json
data/website-launch-*.lock
data/website-owner-*.lock

# Browser verification snapshots and screenshots.
.playwright-mcp/

# Serialize data management and startup across local servers.
data/website-data-*.lock

# Disposable API experiments, response memoization and benchmark caches.
tmp/
