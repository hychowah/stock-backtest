  "cases": [
    {
      "id": "operating_yield_three_year",
      "definition": {
        "format": "variable-definition",
        "version": 1,
        "parameter_catalog": "financial-parameters/1",
        "temporal_policy": "annual-lag90/1",
        "expression": {
          "op": "div",
          "left": {
            "op": "mul",
            "left": {
              "op": "parameter",
              "id": "annual.revenue"
            },
            "right": {
              "op": "annual",
              "stat": "mean",
              "count": 3,
              "parameter": "annual.operating_margin"
            }
          },
          "right": {
            "op": "parameter",
            "id": "market.enterprise_value"
          }
        },
        "output": {
          "unit": "scalar",
          "display": "percent"
        }
      },
      "context": {
        "symbol": "EXAMPLE",
        "screen_date": "2025-01-02",
        "selected_fiscal": "2023-12-31"
      },
      "inputs": {
        "annual": [
          {
            "fiscal": "2021-12-31",
            "revenue": 100000000,
            "operatingIncome": 10000000
          },
          {
            "fiscal": "2022-12-31",
            "revenue": 200000000,
            "operatingIncome": 40000000
          },
          {
            "fiscal": "2023-12-31",
            "revenue": 300000000,
            "operatingIncome": 90000000
          }
        ],
        "enterprise_value": 600000000
      },
      "expected": {
        "valid": true,
        "value": 0.1,
        "display": "10%",
        "annual_margins": [
          0.1,
          0.2,
          0.3
        ],
        "mean_margin": 0.2,
        "normalized_operating_income": 60000000
      },
      "explanation": "300m \u00d7 mean(0.1,0.2,0.3) / 600m. Ratio of pooled amounts would be 140m/600m and is a different formula."
    },
