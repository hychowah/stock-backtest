    {
      "id": "calendar_mean",
      "definition": {
        "format": "variable-definition",
        "version": 1,
        "parameter_catalog": "financial-parameters/1",
        "temporal_policy": "annual-lag90/1",
        "expression": {
          "op": "calendar",
          "stat": "mean",
          "months": 1,
          "parameter": "market.adjusted_price",
          "sampling": "spy_sessions",
          "coverage": "all_exact"
        },
        "output": {
          "unit": "USD/share",
          "display": "usd_per_share"
        }
      },
      "context": {
        "symbol": "WINDOW",
        "screen_date": "2024-03-04"
      },
      "inputs": {
        "window_start_exclusive": "2024-02-04",
        "spy_sessions": [
          "2024-02-05",
          "2024-03-01",
          "2024-03-04"
        ],
        "adjusted_prices": [
          10,
          20,
          30
        ],
        "calendar_is_synthetic": true
      },
      "expected": {
        "valid": true,
        "value": 20
      },
      "explanation": "Every declared synthetic SPY session has one exact price. Omitting any price yields INCOMPLETE_WINDOW. A backend may reject this operation as unsupported before evaluation."
    },
